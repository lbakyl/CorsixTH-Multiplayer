<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only for the ad hoc test of sign_macos_app.sh (sign-macos.yml, "test"
     job): an ad hoc signature has no team, so the hardened runtime's library
     validation would refuse the app's own libraries. The real signature needs
     no entitlements: everything in the app has the same team. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
